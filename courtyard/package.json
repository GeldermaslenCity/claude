{
  "name": "dead-courtyard",
  "private": true,
  "description": "Round-based 3D zombie survival game (Three.js)",
  "scripts": {
    "build": "esbuild js/main.js --bundle --format=iife --minify --alias:three=./vendor/three/three.module.js --outfile=game.bundle.js --legal-comments=eof",
    "watch": "npm run build -- --watch",
    "start": "npx http-server -p 8000 -c-1 ."
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
